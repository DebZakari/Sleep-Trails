{
  "schemaVersion": 1,
  "id": "sleep_trails",
  "version": "${version}",
  "name": "Sleep Trails",
  "description": "Smooths sky transitions during sleep and server time jumps, with star trails for vanilla rendering and supported Vitrail or Iris setups. Client-side only.",
  "authors": ["EngrLightning"],
  "contact": {
    "homepage": "https://github.com/DebZakari/Sleep-Trails",
    "sources": "https://github.com/DebZakari/Sleep-Trails",
    "issues": "https://github.com/DebZakari/Sleep-Trails/issues"
  },
  "license": "MIT",
  "icon": "assets/sleep_trails/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.sleeptrails.SleepTrailsClient"],
    "modmenu": ["dev.sleeptrails.config.ModMenuEntry"],
    "sodium:config_api_user": ["dev.sleeptrails.config.SodiumEntry"]
  },
  "mixins": ["sleep-trails.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*",
    "sodium": "*"
  }
}
