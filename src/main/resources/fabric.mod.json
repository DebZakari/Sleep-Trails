  "authors": ["EngrLightning"],
  "license": "MIT",
  "icon": "assets/sleep_trails/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.sleeptrails.SleepTrailsClient"],
    "modmenu": ["dev.sleeptrails.config.ModMenuEntry"],
    "sodium:config_api_user": ["dev.sleeptrails.config.SodiumEntry"]
  },
  "mixins": ["sleep-trails.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*",
    "sodium": "*"
  }
}
