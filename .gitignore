# Only the source, build files, license and public documentation and media belong in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/src/
!/docs/

/gradle/*
!/gradle/reference-dependencies.json
!/gradle/wrapper/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

/src/*
!/src/main/
!/src/test/

/docs/*
!/docs/BUILDING.md
!/docs/media/
/docs/media/*
!/docs/media/showcase.gif

# Public Markdown files are explicitly listed above and below.
*.md
!/README.md
!/docs/BUILDING.md

# Local instructions, settings, credentials and generated files at any depth.
AGENTS.md
CLAUDE.md
HANDOFF.md
.agents/
.claude/
.codex/
.cursor/
.env*
*.pem
*.key
*.p12
*.pfx
*.iml
.idea/
.vscode/
.gradle/
.gradle-user-home/
build/
run/
__pycache__/
*.pyc
*.class
*.jar
!/gradle/wrapper/gradle-wrapper.jar

